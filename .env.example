# .env.example: copy to .env (git-ignored) and uncomment what you need.
# Precedence: configs/config.yaml < .env < real environment variables.

# Which YAML file to load (default: configs/config.local.yaml if present, else config.yaml)
# CONFIG_PATH=configs/config.yaml

# DOCVIEWER_SERVER_ADDR=:8080
# DOCVIEWER_SERVER_CORS_ORIGINS=http://localhost:5173
# DOCVIEWER_SERVER_SHUTDOWN_GRACE=10s

# DOCVIEWER_SOURCES_REQUEST_TIMEOUT=3s
# DOCVIEWER_SOURCES_MAX_BODY_BYTES=1048576
# A map is set as a whole, as JSON, e.g. to run against mocks on localhost:
# DOCVIEWER_SOURCES_UPSTREAMS={"sales":{"base_url":"http://localhost:8081","timeout":"2s"},"service":{"base_url":"http://localhost:8082","timeout":"2s"}}

# DOCVIEWER_RESILIENCE_MAX_RETRIES=1
# DOCVIEWER_RESILIENCE_MIN_BUDGET=500ms
# DOCVIEWER_RESILIENCE_MAX_JITTER=100ms
# DOCVIEWER_RESILIENCE_TRIP_AFTER=5
# DOCVIEWER_RESILIENCE_COOLDOWN=30s

# DOCVIEWER_TELEMETRY_LOG_LEVEL=debug
# DOCVIEWER_TELEMETRY_REDACT_ENABLED=false   # local debugging only; logs a warning

# Read by the OpenTelemetry SDK, not by our config schema
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
