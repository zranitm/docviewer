{
  "uid": "docviewer",
  "title": "docviewer",
  "tags": ["docviewer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second, by status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (rate(docviewer_http_request_duration_seconds_count{route=\"/v1/vehicles/:vin/documents\"}[$__rate_interval]))", "legendFormat": "{{code}}" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Request latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "max": 3.5 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(docviewer_http_request_duration_seconds_bucket{route=\"/v1/vehicles/:vin/documents\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(docviewer_http_request_duration_seconds_bucket{route=\"/v1/vehicles/:vin/documents\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(docviewer_http_request_duration_seconds_bucket{route=\"/v1/vehicles/:vin/documents\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Source results per second, by source and status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (source, status) (rate(docviewer_source_results_total[$__rate_interval]))", "legendFormat": "{{source}} {{status}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Source call latency p95, by source",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "max": 2.5 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, source) (rate(docviewer_source_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{source}}" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "Circuit breaker state, by source",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" }, "1": { "text": "half-open", "color": "orange" }, "2": { "text": "open", "color": "red" } } }
          ],
          "noValue": "closed"
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "max by (source) (docviewer_breaker_state)", "legendFormat": "{{source}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Coalesced requests per second",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(docviewer_coalesced_requests_total[$__rate_interval]))", "legendFormat": "coalesced" }
      ]
    },
    {
      "id": 7, "type": "logs", "title": "Service logs (redacted)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"docviewer\"}" }
      ]
    }
  ]
}
